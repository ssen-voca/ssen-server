DB_URL=jdbc:postgresql://localhost:5433/ssen
DB_PORT=5433
DB_USERNAME=ssen
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
# 브라우저(웹)에서 API를 호출할 수 있는 출처 (쉼표 구분). local 프로필은 기본값이 있고, 운영에서는 필수 지정.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8099
# 교사 가입 코드 — 교사 가입 시 입력해야 하는 코드. local 프로필은 기본값(local-teacher-code)이 있고, 운영에서는 필수 지정.
TEACHER_INVITE_CODE=change-me-teacher-code
