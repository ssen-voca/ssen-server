DB_URL=jdbc:postgresql://localhost:5433/ssen
DB_PORT=5433
DB_USERNAME=ssen
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
# 브라우저(웹)에서 API를 호출할 수 있는 출처 (쉼표 구분). local 프로필은 기본값이 있고, 운영에서는 필수 지정.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8099
# 교사 계정 — 학교|이름|번호4자리를 ; 또는 줄바꿈으로 구분. 교사는 학생과 같은 로그인으로 들어오며, 번호는 비밀이다.
# local 프로필은 기본값(테스트학원|테스트교사|0000)이 있고, 운영은 비어 있으면 교사가 없다.
TEACHER_ACCOUNTS=데모학원|김선생|1234;데모학원|박선생|5678
